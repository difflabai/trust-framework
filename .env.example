# Configuration for scripts/near/*.sh. Copy it with
#   install -m 600 .env.example .env
# (.env is gitignored; 0600 because it will hold a private key) and fill in.
# The scripts parse KEY=VALUE lines (they never source or eval this file;
# only a leading ~/ in a path is expanded); variables already set in the
# environment take precedence.

# Network: testnet (default), mainnet or sandbox. Mainnet also needs
# NEAR_ALLOW_MAINNET=1 in the environment (it is ignored in this file).
NEAR_NETWORK=testnet
# Optional RPC override (default https://test.rpc.fastnear.com on testnet).
# Must be https:// unless it is localhost; its chain_id must match NEAR_NETWORK.
# NEAR_RPC_URL=https://rpc.testnet.near.org

# The account that pays, creates subaccounts and (by default) owns the contract.
NEAR_ACCOUNT_ID=difflabai.testnet
# A FULL-ACCESS key of NEAR_ACCOUNT_ID (ed25519:<base58>). Never commit it.
NEAR_PRIVATE_KEY=
# Optional: its public key; the scripts refuse to run if it doesn't match.
# NEAR_PUBLIC_KEY=ed25519:...

# Contract account and owner (defaults shown).
# APPROVAL_CONTRACT_ID=approvals.difflabai.testnet
# APPROVAL_OWNER_ID=difflabai.testnet
# Balance for a newly created contract account (default: computed from the
# wasm size, 3 NEAR for the current contract).
# APPROVAL_INITIAL_BALANCE=3
# Balance for accounts created by new-principal.sh (default 0.5 NEAR).
# APPROVAL_PRINCIPAL_BALANCE=0.5

# Where principal keys and deployment records go (relative to the repo root,
# or ~/...). Keeping the credentials outside the worktree is safer, e.g.
# NEAR_CREDENTIALS_DIR=~/.config/trust-framework/near-credentials
# NEAR_CREDENTIALS_DIR=.near-credentials
# NEAR_DEPLOYMENTS_DIR=scripts/near/deployments
